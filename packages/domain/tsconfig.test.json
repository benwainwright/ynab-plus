{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.test.tsbuildinfo",
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@core": ["./src/core/index.ts"],
      "@user": ["./src/user/index.ts"],
      "@regular-task": ["./src/regular-task/index.ts"],
      "@transaction": ["./src/transaction/index.ts"],
      "@account": ["./src/account/index.ts"],
      "@oauth-token": ["./src/oauth-token/index.ts"],
      "@sync-details": ["./src/sync-details/index.ts"]
    }
  },
  "include": ["src/**/*.test.ts"],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}

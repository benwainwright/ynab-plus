{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@core": ["./src/core/index.ts"],
      "@ports": ["./src/ports/index.ts"],
      "@ports/groups": ["./src/ports/groups/index.ts"],
      "@errors": ["./src/errors/index.ts"],
      "@services": ["./src/services/index.ts"],
      "@services/open-banking": ["./src/services/open-banking/index.ts"],
      "@services/oauth": ["./src/services/oauth/index.ts"]
    }
  },
  "references": [
    {
      "path": "../domain"
    },
    {
      "path": "../bootstrap"
    },
    {
      "path": "../serialiser"
    },
    {
      "path": "../test-helpers"
    }
  ],
  "include": ["./src/**/*.ts"],
  "exclude": ["./src/**/*.test.ts", "src/test-helpers/setup.ts"]
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.test.tsbuildinfo",
    "emitDeclarationOnly": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vitest/globals", "node"],
    "paths": {
      "@ports": ["./src/ports/index.ts"],
      "@errors": ["./src/errors/index.ts"],
      "@services": ["./src/services/index.ts"],
      "@test-helpers": ["./src/test-helpers/index.ts"],
      "@services/open-banking": ["./src/services/open-banking/index.ts"],
      "@services/oauth": ["./src/services/oauth/index.ts"],
    },
  },
  "include": ["src/**/*.test.ts", "src/test-helpers/setup.ts"],
  "references": [
    {
      "path": "./tsconfig.lib.json",
    },
  ],
}

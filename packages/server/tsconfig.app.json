{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@core": ["./src/core/index.ts"],
      "@websocket-server": ["./src/websocket-server/index.ts"],
      "@task-scheduler": ["./src/task-scheduler/index.ts"]
    }
  },
  "references": [
    {
      "path": "../application"
    },
    {
      "path": "../bootstrap"
    },
    {
      "path": "../integration-adapters"
    },
    {
      "path": "../sqlite-adapters"
    },
    {
      "path": "../node-adapters"
    }
  ],
  "include": ["src/**/*.ts", "./start.ts"],
  "exclude": ["src/**/*.test.ts"]
}

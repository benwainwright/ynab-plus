{
  "name": "ynab-plus",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:websocket": "pnpm run --filter '*server' dev",
    "dev:frontend": "pnpm run --filter '*frontend' dev",
    "dev": "pnpm run dev:websocket & pnpm run dev:frontend",
    "lint": "oxlint . --type-aware",
    "lint:packageJson": "npmPkgJsonLint .",
    "lint:fix": "oxlint . --type-aware --fix",
    "test:e2e": "playwright test",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "type-check": "pnpm run --filter '*frontend' typegen && tsgo --build",
    "type-check:watch": "tsgo --build --watch",
    "prepare": "husky",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/bcrypt": "6.0.0",
    "@types/bun": "latest",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "@typescript/native-preview": "7.0.0-dev.20251112.1",
    "@vitest/coverage-v8": "4.0.8",
    "get-port": "7.1.0",
    "husky": "9.1.7",
    "msw": "2.12.2",
    "npm-package-json-lint": "9.0.0",
    "oxfmt": "0.17.0",
    "oxlint": "1.32.0",
    "oxlint-tsgolint": "0.9.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "vite-node": "5.0.0",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.0.8",
    "vitest-mock-extended": "3.1.0",
    "vitest-when": "0.10.0",
    "ws": "8.18.3"
  },
  "dependencies": {
    "@epegzz/winston-dev-console": "1.3.4",
    "@inversifyjs/strongly-typed": "2.2.0",
    "@standard-schema/spec": "1.0.0",
    "@types/stack-trace": "0.0.33",
    "reflect-metadata": "0.2.2",
    "stacktracey": "2.1.8",
    "uuid": "13.0.0",
    "winston": "3.18.3",
    "zod": "4.1.12"
  }
}
